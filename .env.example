# AI 模型 API 中转站 —— 运行配置样例
# 复制为 .env 并按需填写（.env 已被 git 忽略，不会入库）。
# 也可直接设置为进程环境变量，二者等效（进程环境变量优先）。

# ---- 真实模型后端（留空则回退模拟后端，便于离线演示）----
# 配置后，/v1/chat/completions 会真实调用对应厂商 API，并按真实 usage 计费。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---- 告警投递（可选）----
# 配置后，agent.ops 的异常告警会投递到群机器人；未配置则仅打印。
WEBHOOK_URL=
WEBHOOK_TYPE=dingtalk   # dingtalk | feishu

# ---- 持久化（可选，也可用 --db 指定）----
# 默认数据库路径：data/gateway.sqlite3
GATEWAY_DB=data/gateway.sqlite3