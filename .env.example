# FlowERP production configuration. Copy to .env; never commit the real file.
FLOWERP_ENV=production
FLOWERP_AUTH_REQUIRED=true
FLOWERP_BIND_IP=127.0.0.1
FLOWERP_HOST=0.0.0.0
FLOWERP_PORT=8000
FLOWERP_ALLOWED_ORIGINS=https://erp.example.com
FLOWERP_COOKIE_SECURE=true
FLOWERP_SESSION_HOURS=12
FLOWERP_MAX_BODY_BYTES=1000000
FLOWERP_DB_BUSY_TIMEOUT_MS=5000
FLOWERP_LEGACY_API_ENABLED=false
FLOWERP_MAX_CONCURRENT_REQUESTS=64
FLOWERP_REQUEST_RATE_PER_MINUTE=600
FLOWERP_REQUEST_TIMEOUT_SECONDS=30
FLOWERP_MIN_FREE_DISK_MB=512
FLOWERP_BACKUP_MAX_AGE_HOURS=36
# Enable only after the first verified backup has been created.
FLOWERP_REQUIRE_RECENT_BACKUP=false

# Optional: path to a separately installed Codex CLI used by the delivery workbench.
# FLOWERP_CODEX_COMMAND=C:\\Tools\\codex.exe

# Bootstrap is performed once with: python -m workbench.cli init
# Do not store the initial administrator password in this file.
