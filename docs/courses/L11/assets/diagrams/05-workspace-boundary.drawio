<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram name="仓库与候选边界"><mxGraphModel page="1" pageScale="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="先认清三个位置：准备在控制仓库，实际修改只在隔离候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="70" as="geometry"/></mxCell>
<mxCell id="control" value="① CodexFDE 控制仓库&#xa;运行第 1～4 步准备命令&#xa;保存课程、工作台、提交模板" style="swimlane;startSize=38;rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="400" height="230" as="geometry"/></mxCell>
<mxCell id="customer" value="② 独立 FlowERP 客户仓库&#xa;提供采购业务源码&#xa;不直接在这里完成本讲练习" style="swimlane;startSize=38;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="400" height="230" as="geometry"/></mxCell>
<mxCell id="candidate" value="③ 工作台返回的隔离候选&#xa;第 5～6 步的唯一工作目录&#xa;组合来源：agent／flowerp／eval／tests" style="swimlane;startSize=38;rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="400" height="230" as="geometry"/></mxCell>
<mxCell id="submit" value="第 4.2 步提交任务&#xa;返回 task.id、isolation.path、status" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=17;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="430" height="110" as="geometry"/></mxCell>
<mxCell id="verify" value="进入候选后先核对&#xa;当前目录 = isolation.path&#xa;三个源码导入均指向候选" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="310" height="170" as="geometry"/></mxCell>
<mxCell id="stop" value="不一致：停止&#xa;不要在控制仓库或客户仓库代做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="710" width="370" height="90" as="geometry"/></mxCell>
<mxCell id="go" value="一致：才启动真实子 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="710" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="e1" value="读取课程合同" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" parent="1" source="control" target="submit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="登记来源与哈希" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" parent="1" source="customer" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="生成个人候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" parent="1" source="submit" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="切换目录并核对" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" parent="1" source="candidate" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=15;" edge="1" parent="1" source="verify" target="stop"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=15;" edge="1" parent="1" source="verify" target="go"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
