<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="31.4.4">
  <diagram name="L04-授权与实际边界" id="L04-授权与实际边界">
    <mxGraphModel page="1" pageScale="1" pageWidth="900" pageHeight="735" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="先明确授权，再核对实际变化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#4389c7;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="860" height="55" as="geometry" />
        </mxCell>
        <mxCell id="authorize" value="1 你确认本轮要求&lt;br&gt;目标、允许文件、命令与超时" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2dc;strokeColor=#c08b37;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="840" height="90" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="2 创建本轮副本&lt;br&gt;工作区权限由执行环境控制" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#4389c7;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="245" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="implement" value="3 Codex 实现&lt;br&gt;按说明修改允许的文件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf4ff;strokeColor=#4389c7;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="245" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="diff" value="4 核对修改（Diff）&lt;br&gt;实际变更对照允许文件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#318775;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="425" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="5 运行程序检查（Eval）&lt;br&gt;保留各项结果与退出码" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#318775;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="425" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="越界、工具失败或超时&lt;br&gt;保留现场，停止推进" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#c46652;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="605" width="370" height="85" as="geometry" />
        </mxCell>
        <mxCell id="review" value="6 由指定的人验收&lt;br&gt;按结果记录接受或退回" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2dc;strokeColor=#c08b37;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#18344c;spacing=12;" vertex="1" parent="1">
